# PostgreSQL Configuration
POSTGRES_PASSWORD=seethbot_secure_change_me_in_production
POSTGRES_DB=seethbot
POSTGRES_USER=seethbot

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@seethbot.local
PGADMIN_PASSWORD=admin

# Application Configuration
NODE_ENV=production
PORT=3000

# Prisma Database URL (for PostgreSQL - used by Docker Compose)
DATABASE_URL="postgresql://seethbot:${POSTGRES_PASSWORD}@postgres:5432/seethbot?schema=public"

# Git Build Info (auto-populated by deploy.sh)
GIT_HASH=unknown
GIT_BRANCH=unknown

# JWT Secret (REQUIRED in production - generate with: openssl rand -hex 32)
SEETHBOT_JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# CORS Origins (comma-separated, leave empty for open CORS during development)
CORS_ORIGINS=

# API Keys (comma-separated, leave empty for auto-generated dev key)
SEETHBOT_API_KEYS=
