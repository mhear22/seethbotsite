# PostgreSQL Configuration
POSTGRES_PASSWORD=seethbot_secure_change_me_in_production
POSTGRES_DB=seethbot
POSTGRES_USER=seethbot

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@seethbot.local
PGADMIN_PASSWORD=admin

# Application Configuration
NODE_ENV=production
PORT=3000

# Prisma Database URL (for PostgreSQL)
DATABASE_URL="postgresql://seethbot:seethbot_secure_change_me_in_production@postgres:5432/seethbot?schema=public"

# External Database URL (for local connections)
DATABASE_URL_EXTERNAL="postgresql://seethbot:seethbot_secure_change_me_in_production@localhost:5432/seethbot?schema=public"
