# PostgreSQL Configuration
POSTGRES_PASSWORD=seethbot_secure_change_me_in_production
POSTGRES_DB=seethbot
POSTGRES_USER=seethbot

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@seethbot.local
PGADMIN_PASSWORD=admin

# Application Configuration
NODE_ENV=production
PORT=3000

# Prisma Database URL (for PostgreSQL - used by Docker Compose)
DATABASE_URL="postgresql://seethbot:${POSTGRES_PASSWORD}@postgres:5432/seethbot?schema=public"

# Git Build Info (auto-populated by deploy.sh)
GIT_HASH=unknown
GIT_BRANCH=unknown
