# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/seethbotsite?schema=public"

# REQUIRED: JWT Secret for token signing
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SEETHBOT_JWT_SECRET="your-secure-random-secret-here"

# Optional: API Keys (comma-separated)
# SEETHBOT_API_KEYS="sk_your_api_key_1,sk_your_api_key_2"

# Optional: Port (defaults to 3000 in production, 3001 in development)
# PORT=3001

# Recommended in production: comma-separated allowlist of permitted CORS origins.
# If unset, the API allows requests from ANY origin (a warning is logged in production).
# CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
