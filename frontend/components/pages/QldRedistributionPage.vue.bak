const getStatusLabel = (status: string) => {
  switch (status) {
    case 'abolished': return '❌ ABOLISHED'
    case 'new': return '✨ NEW SEAT'
    case 'changed': return '⚠️ CHANGED'
    default: return status.toUpperCase()
  }
}

