const filteredElectorates = computed(() => {
  if (selectedParty.value === 'all') return electorates
  if (selectedParty.value === 'abolished') return electorates.filter(e => e.status === 'abolished')
  if (selectedParty.value === 'new') return electorates.filter(e => e.status === 'new')
  return electorates.filter(e => e.party === selectedParty.value)
})

const getPartyClass = (party: string) => {
  switch (party) {
    case 'Labor': return 'party-labor'
    case 'LNP': return 'party-lnp'
    case 'Greens': return 'party-greens'
    case 'KAP': return 'party-kap'
    case 'Independent': return 'party-independent'
    default: return ''
  }
}

