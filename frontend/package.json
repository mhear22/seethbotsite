{
  "name": "seethbotsite",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue.js + TypeScript + Vite interactive website",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:images && npm run generate:types || true && vite build",
    "preview": "vite preview",
    "generate:types": "openapi-typescript ../backend/dist/openapi.json -o ./src/types/openapi.ts",
    "generate:images": "node scripts/generate-image-sizes.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@types/three": "^0.182.0",
    "openapi-fetch": "^0.15.0",
    "openapi-typescript": "^7.10.1",
    "pinia": "^3.0.4",
    "three": "^0.182.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "jsdom": "^25.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^5.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhear22/seethbotsite.git"
  },
  "author": "",
  "license": "ISC"
}
