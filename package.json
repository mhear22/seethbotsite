{
  "name": "seethbotsite-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root for seethbotsite",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "test": "pnpm --filter ./backend test && pnpm --filter ./frontend test",
    "build:backend": "pnpm --filter ./backend build",
    "build:frontend": "pnpm --filter ./frontend build",
    "build:mech": "pnpm --filter ./apps/mech/frontend build",
    "build:mech-backend": "pnpm --filter ./apps/mech/backend build"
  },
  "dependencies": {
    "openclaw": "^2026.2.14"
  }
}
